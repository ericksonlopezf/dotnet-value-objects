<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
    <GenerateDocumentationFile Condition="'$(IsTestProject)' != 'true' and '$(MSBuildProjectName)' != 'EricksonLopez.ValueObjects.Samples' and '$(MSBuildProjectName)' != 'EricksonLopez.ValueObjects.Benchmarks'">true</GenerateDocumentationFile>

    <!-- Versioning -->
    <Version>1.0.0</Version>

    <!-- Package Metadata -->
    <Authors>Erickson Lopez</Authors>
    <Company>Erickson Lopez</Company>
    <Copyright>Copyright © Erickson Lopez. MIT License.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://ericksonlopez.dev/value-objects</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ericksonlopezf/dotnet-value-objects</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <CommonPackageTags>dotnet;csharp;ddd;value-objects</CommonPackageTags>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'EricksonLopez.ValueObjects.Analyzers' and '$(MSBuildProjectName)' != 'EricksonLopez.ValueObjects.Generators'">
    <Using Include="EricksonLopez.Result" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsTestProject)' == 'true' and '$(MSBuildProjectName)' != 'EricksonLopez.ValueObjects.Analyzers.UnitTests' and '$(MSBuildProjectName)' != 'EricksonLopez.ValueObjects.Generators.UnitTests'">
    <Compile Include="$(MSBuildThisFileDirectory)tests\Common\ValueObjectContractExtensions.cs" Link="Common\ValueObjectContractExtensions.cs" />
    <Using Include="EricksonLopez.ValueObjects.UnitTests" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false' and '$(IsTestProject)' != 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
