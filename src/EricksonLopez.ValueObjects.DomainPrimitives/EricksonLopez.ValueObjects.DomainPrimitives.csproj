<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>EricksonLopez.ValueObjects.DomainPrimitives</AssemblyName>
    <RootNamespace>EricksonLopez.ValueObjects.DomainPrimitives</RootNamespace>
    <Description>DomainPrimitives bridge and adapter layer for EricksonLopez.ValueObjects. Enables bidirectional conversion and contract compatibility between Value Objects and IDomainPrimitive contracts.</Description>
    <PackageTags>$(CommonPackageTags);domain-primitives;strongly-typed-id;abstractions;interoperability;type-safety;native-aot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.ValueObjects\EricksonLopez.ValueObjects.csproj" />
    <PackageReference Include="EricksonLopez.DomainPrimitives.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EricksonLopez.ValueObjects.DomainPrimitives.Tests" />
  </ItemGroup>
</Project>
