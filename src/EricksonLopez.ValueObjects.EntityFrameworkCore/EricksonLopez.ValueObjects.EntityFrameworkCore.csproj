<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>EricksonLopez.ValueObjects.EntityFrameworkCore</AssemblyName>
    <RootNamespace>EricksonLopez.ValueObjects.EntityFrameworkCore</RootNamespace>
    
    <Title>EricksonLopez.ValueObjects.EntityFrameworkCore</Title>
    <Description>Entity Framework Core integration for EricksonLopez.ValueObjects. Provides NativeAOT-ready ValueConverters, value comparers, and model configuration conventions for domain Value Objects.</Description>
    <PackageTags>$(CommonPackageTags);efcore;entity-framework-core;orm;value-converter;persistence;native-aot</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.ValueObjects\EricksonLopez.ValueObjects.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EricksonLopez.ValueObjects.EntityFrameworkCore.Tests" />
  </ItemGroup>
</Project>
